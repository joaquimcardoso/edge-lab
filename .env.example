# edge-lab environment variables. Copy to .env and fill in real values.
# NEVER commit .env -- it is already in .gitignore.
# Naming convention and per-source instructions: docs/08-credentials.md
# Production (the Pi) gets its OWN separate .env, created directly on
# the device -- never copied from a laptop, never synced through git.

# SEC EDGAR: not a secret, but required by SEC's fair-access policy.
# A descriptive string naming the requester and a contact email.
EDGELAB_SEC_USER_AGENT="edge-lab research <your-email>"

# Finnhub: free API key. Candidate source, not yet integrated into
# any collector (docs/02-data-sources.md).
EDGELAB_FINNHUB_API_KEY=

# Where collected data (raw snapshots, SQLite stores, reports) lives.
# Local/dev: a path under the repo, e.g. ./data
# Pi: the external USB3 disk, e.g. /mnt/data/edgelab
EDGELAB_DATA_DIR=./data

# Optional overrides -- default to paths under EDGELAB_DATA_DIR if unset.
# EDGELAB_RAW_DB_PATH=
# EDGELAB_EVENT_DB_PATH=
# EDGELAB_REPORTS_DIR=
# EDGELAB_UNIVERSE_PATH=config/universe.csv
# EDGELAB_LOG_DIR=

# Telegram: OPTIONAL. Both must be set for notifications to send --
# if either is missing, the daily report still builds and writes to
# disk as normal, just without a Telegram push (docs/08-credentials.md).
# This delivers operational status only (collection counts, Gate 0
# progress, integrity, disk). No trading signal exists yet, so none
# is ever sent here.
# EDGELAB_TELEGRAM_BOT_TOKEN=
# EDGELAB_TELEGRAM_CHAT_ID=
